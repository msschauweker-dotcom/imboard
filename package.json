{
  "name": "offgrid",
  "version": "2.0.0",
  "private": true,
  "description": "OFFGRID — daily puzzles, an unlimited arcade, and real-time versus. Think for yourself.",
  "scripts": {
    "dev": "concurrently -k -n web,game -c green,magenta \"next dev -p 3000\" \"tsx watch server/index.ts\"",
    "dev:web": "next dev -p 3000",
    "dev:server": "tsx watch server/index.ts",
    "build": "next build",
    "start": "tsx server/index.ts",
    "preview": "node scripts/serve-static.mjs",
    "server": "tsx server/index.ts",
    "words": "node scripts/build-words.mjs",
    "test": "tsx tests/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "framer-motion": "11.11.9",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.5.12",
    "an-array-of-english-words": "2.0.0",
    "autoprefixer": "10.4.20",
    "concurrently": "9.0.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "tsx": "4.19.1",
    "typescript": "5.6.3"
  }
}
